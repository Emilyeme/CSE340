<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        
        <p>Here are a few of our partner organizations:</p>
        <ul>

            <% organizations.forEach(organization => { %>
            <li>
                <img 
                    src="/images/<%= organization.logo_filename %>" 
                    alt="<%= organization.name %> logo"
                    class="organization-logo">

                <strong>
                    <a href="/organization/<%= organization.organization_id %>">
                        <%= organization.name %>
                    </a>
                </strong>: <%= organization.contact_email %>

            </li>
            
            <% }); %>

            
            <% if (user && user.role_name === 'admin') { %><p><a href="/new-organization">Add New Organization</a></p><% } %>
            
            
            
        </ul>
    </main>

<%- include('partials/footer') %>