<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>
    <% if (user && user.role_name === 'admin') { %><p> <a href="/users">View All Users</a> </p><% } %>
    <hr>

    <h2>My Volunteer Projects</h2>

    <% if (volunteerProjects && volunteerProjects.length > 0) { %>

        <ul>
            <% volunteerProjects.forEach(project => { %>
                <li>
                    <h3>
                        <a href="/project/<%= project.project_id %>">
                           <%= project.title %>
                        </a>
                    </h3>

                    <p>
                        <strong>Organization:</strong>
                           <%= project.organization_name %>
                    </p>

                    <p>
                        <strong>Date:</strong>
                           <%= project.date %>
                    </p>

                    <p>
                        <strong>Location:</strong>
                           <%= project.location %>
                    </p>

                    <p>
                        <a href="/unvolunteer/<%= project.project_id %>">
                            Remove yourself as a volunteer
                        </a>
                    </p>
                </li>
            <% }) %>
        
        </ul>

    <% } else { %>

        <p>You are not volunteering for any projects yet.</p>

    <% } %>

</main>

<%- include('partials/footer') %>