<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>Here are our upcoming service projects:</p>

    <ul>
        <% projects.forEach(project => { %>
            <li>
                <a href="/project/<%= project.project_id %>">
                    <strong><%= project.title %></strong>
                </a>

                -
                <a href="/organization/<%= project.organization_id %>">
                    <%= project.organization_name %>
                </a>
                <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
            </li>
        <% }) %>
        <p><a href="/new-project">Add a New Service Project</a></p>
        
    </ul>
</main>

<%- include('partials/footer') %>